# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ── Twilio SMS ───────────────────────────────────────────────────────────────
# Sign up at https://www.twilio.com and get credentials from your Console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio phone number (E.164 format)

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Works with Gmail, Outlook, SendGrid, or any SMTP provider.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASSWORD=your_app_password   # Use an App Password, not your main password
#
# Outlook/Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=salon@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=salon@example.com
SMTP_FROM_NAME=Glamour Hair Salon
SMTP_USE_TLS=1
